# Copy to a Git-ignored .env only when Oracle is installed; Spring does not auto-load this file.
ORACLE_JDBC_URL=jdbc:oracle:thin:@localhost:1521/FREEPDB1
ORACLE_DB_USER=replace_me
ORACLE_DB_PASSWORD=replace_me
# STEP 12: the default Mock needs no key. This file is not loaded automatically.
# Real provider also requires gemini-live, explicit acknowledgements and a reviewed model.
# Read docs/gemini-free-tier.md before enabling; never paste a real key into a command or Git.
GOOGLE_API_KEY=
