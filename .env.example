# 변수 이름만 제공한다. 이 파일은 자동으로 읽지 않으며 실제 값은 환경에 안전하게 설정한다.
# Mock 기본 실행에는 어느 비밀값도 필요하지 않다. 관리자 시연에만 일시적으로 비밀번호를 지정한다.
ORACLE_JDBC_URL=
ORACLE_DB_USER=
ORACLE_DB_PASSWORD=
BANS_ORACLE_FIRST_ADMIN_PASSWORD=
BANS_ORACLE_ALLOW_SHORT_DEMO_PASSWORD=NO
GOOGLE_API_KEY=
# bans_chatbot/.env에 저장하며, 아래 값은 실제 Gemini를 사용하기 전에 직접 확인한다.
bans.ai.provider=mock
bans.ai.model=gemini-2.5-flash-lite
bans.ai.external-transfer-acknowledged=false
bans.ai.free-tier-confirmed=false
# 아래는 별도 실험의 명시적 gate이며 기본값/실제 허가를 제공하지 않는다.
BANS_GEMINI_SMOKE=
BANS_GEMINI_FREE_TIER_CONFIRMED=
BANS_GEMINI_TRANSFER_ACKNOWLEDGED=
BANS_MOCK_LOAD_TEST=
BANS_UI_BROWSER_TEST=
ORACLE_EMPTY_SCHEMA_MIGRATION_TEST=
ORACLE_SYNTHETIC_SEED_TEST=
ORACLE_AUTH_TEST=
ORACLE_ORGANIZATION_TEST=
ORACLE_CHAT_TEST=
ORACLE_DOCUMENT_TEST=
ORACLE_DOCUMENT_SEARCH_TEST=
ORACLE_AI_TOOL_TEST=
ORACLE_AI_QUESTION_TEST=
ORACLE_UI_TEST=
ORACLE_SECURITY_TEST=
ORACLE_LOAD_TEST=
ORACLE_LOAD_WRITES_ACK=
